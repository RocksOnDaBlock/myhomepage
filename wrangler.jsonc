{
  // dustingillis.online - static site served as a Cloudflare Worker (assets only)
  "name": "myhomepage",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "dustingillis.online", "custom_domain": true },
    { "pattern": "www.dustingillis.online", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}
